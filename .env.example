# Optional. Research, Investigate, Assistant, and Word Study work without this.
# Only the extra evidence-gathering tools (archaeology, science, government) use it.
# Local: copy to .env.local. Public site: set the same names in Netlify env vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google sign-in. Create a Web application OAuth client in Google Cloud Console.
# Authorized JavaScript origins:
#   http://localhost:5174
#   http://127.0.0.1:5174
#   https://searching-for-truth-173.netlify.app
# Authorized redirect URIs (must include /login):
#   http://localhost:5174/login
#   http://127.0.0.1:5174/login
#   https://searching-for-truth-173.netlify.app/login
# Local Google login works on http://127.0.0.1:5174 — not truth.localhost.
# Client ID is public. The client secret must NOT use a VITE_ name.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
