{
  "name": "ModernFulfillment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "What it is and how it shows fulfillment or occurrence"
    },
    "fulfillment_type": {
      "type": "string",
      "enum": [
        "prophecy_fulfillment",
        "historical_event",
        "archaeological_modern",
        "scientific",
        "other"
      ],
      "title": "Fulfillment Type"
    },
    "prophecy_reference": {
      "type": "string",
      "title": "Prophecy Reference",
      "description": "The passage this modern evidence relates to"
    },
    "modern_date": {
      "type": "string",
      "title": "Modern Date",
      "description": "When the modern event happened"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "source_url": {
      "type": "string",
      "title": "Source URL"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "verification_note": {
      "type": "string",
      "title": "Verification Note",
      "description": "How it supports the fulfillment; honest note on disputes"
    },
    "chronological_order": {
      "type": "number",
      "default": 0,
      "title": "Chronological Order"
    }
  },
  "required": [
    "title",
    "fulfillment_type",
    "prophecy_reference"
  ]
}